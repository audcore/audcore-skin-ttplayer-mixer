#include "resource.h"

AUDCORE_NATIVE_MENU_EDITOR DIALOGEX 0, 0, 180, 50
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT AUDCORE_NATIVE_MENU_VALUE, 8, 8, 164, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 70, 28, 48, 14
    PUSHBUTTON "Cancel", IDCANCEL, 124, 28, 48, 14
END
